{
	"name": "cloudflare-one-dns-privacy-adblock",
	"description": "Pi-Hole Style Privacy/Ad blocking in the cloud leveraging CF One DNS",
	"type": "module",
	"scripts": {
		"build": "qwik build",
		"build.client": "vite build",
		"build.preview": "vite build --ssr src/entry.preview.tsx",
		"build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
		"build.types:cf": "wrangler types",
		"postbuild.types:cf": "prettier --write worker-configuration.d.ts",
		"build.types:tsc": "tsc --incremental --noEmit",
		"build.types": "npm run build.types:cf && npm run build.types:tsc",
		"translate": "inlang machine translate --project project.inlang",
		"build:translate": "tsx helpers/languageGenerate.ts",
		"verify:no-react": "tsx helpers/verifyNoReactInDist.ts",
		"fmt": "prettier --check .",
		"fmt:fix": "prettier --write .",
		"lint": "eslint **/*.*ts*",
		"lint:fix": "npm run lint -- --fix",
		"preview": "qwik build preview && vite preview --open",
		"preview:lhci": "qwik build preview && vite preview --port 8080",
		"dev": "node --inspect=127.0.0.1:9229 node_modules/vite/bin/vite.js --mode ssr --port 5173 --strictPort --force",
		"clean": "npx -y rimraf@latest ./dist ./server ./tmp",
		"prestart:clean": "npm run clean",
		"start:clean": "npm run start",
		"start": "vite --mode ssr --strictPort",
		"qwik": "qwik"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/demosjarco/Cloudflare-One-DNS-Privacy-AdBlock.git"
	},
	"author": "DemosJarco <1209494+demosjarco@users.noreply.github.com>",
	"license": "MIT",
	"private": true,
	"bugs": {
		"url": "https://github.com/demosjarco/Cloudflare-One-DNS-Privacy-AdBlock/issues"
	},
	"homepage": "https://github.com/demosjarco/Cloudflare-One-DNS-Privacy-AdBlock#readme",
	"dependencies": {
		"@cloudflare/kumo": "2.13.2",
		"@qwikest/icons": "0.0.13",
		"cloudflare": "7.1.0",
		"zod": "4.6.4"
	},
	"devDependencies": {
		"@auth/qwik": "0.9.3",
		"@builder.io/qwik": "1.20.1",
		"@builder.io/qwik-city": "1.20.1",
		"@demosjarco/prettier-config": "1.0.2",
		"@eslint/js": "10.0.1",
		"@inlang/cli": "3.3.7",
		"@inlang/paraglide-js": "2.25.4",
		"@microsoft/eslint-formatter-sarif": "3.1.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.5.1",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-qwik": "1.20.1",
		"flowbite": "4.0.2",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.13",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite-tsconfig-paths": "6.1.1",
		"wrangler": "4.131.1"
	}
}
